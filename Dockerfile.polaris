FROM $IMAGE
RUN $Commands

ARG BRIDGE=bridge-cli-bundle-linux64
ARG URL=https://repo.blackduck.com/artifactory/bds-integrations-release/com/blackduck/integration/bridge/binaries/bridge-cli-bundle/latest
ADD ${URL}/${BRIDGE}

RUN unzip -d /opt/bridge ${BRIDGE}; rm ${BRIDGE}

ENV PATH = ${PATH}:/opt/bridge

CMD ["bash"]
